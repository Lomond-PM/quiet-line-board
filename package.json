{
  "name": "@dsh-local/quiet-line-board",
  "version": "1.3.0",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/Lomond-PM/quiet-line-board.git" },
  "scripts": { "test": "node tests/controls.cjs && node tests/state.cjs && node tests/integration.mjs && node tests/dry.cjs && node tests/dry-integration.mjs && node tests/project-store.cjs && node tests/project-integration.mjs && node tests/project-docs.mjs" },
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "description": "A model-callable drawing board with wet oils, dry graphite/charcoal, erasing, smudging, single-file projects, checkpoint history and built-in art guidance.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/core.cjs",
    "lib/oil.cjs",
    "lib/raster.cjs",
    "lib/base-image.cjs",
    "lib/paint-state.cjs",
    "lib/dry-media.cjs",
    "lib/dry-state.cjs",
    "lib/dry-tool.cjs",
    "lib/art-guidance.cjs",
    "lib/project-store.cjs",
    "lib/project-tool.cjs",
    "PROJECTS.md",
    "DRAWING.md",
    "DRY-MEDIA.md",
    "tests/*.cjs",
    "tests/*.mjs",
    "CONTROL.md",
    "CHANGELOG.md",
    "docs/*.png",
    "docs/*.md",
    "examples/*.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "RECOVERY.md",
    "REFINEMENT.md",
    "VOLUME.md",
    "CONTINUATION.md"
  ],
  "dependencies": {
    "sharp": "0.35.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}